generator client {
  provider      = "go run github.com/steebchen/prisma-client-go"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  meals         Meal[]
  ingredients   Ingredient[]
  planner       Planner[]
  shoppingItems ShoppingItem[]
  notifications Notification[]
}

model Meal {
  id             String       @id @default(cuid())
  name           String
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  ingredients    Ingredient[]
  plannerEntries Planner[]

  @@unique([name, userId])
}

model Ingredient {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("Other") // Dairy, Vegetables, Fruits, etc.
  quantity    String?
  unit        String?
  isAvailable Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())
  meals       Meal[]

  @@unique([name, userId])
}

model Planner {
  id        String   @id @default(cuid())
  dayOfWeek String
  mealType  String
  meal      Meal     @relation(fields: [mealId], references: [id])
  mealId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model ShoppingItem {
  id         String    @id @default(cuid())
  name       String
  category   String    @default("Other") // Dairy, Vegetables, Fruits, etc.
  quantity   String?
  note       String?
  status     String    @default("pending") // pending or bought
  targetDate DateTime?
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String // shopping, missing_ingredient, forgotten_item
  isRead    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}
